<Window x:Class="cuatomers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfGif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:cuatomers"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" 
        WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize">

    <!-- ========== STYLES ========== -->
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0EA5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0EA5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ========== MAIN LAYOUT ========== -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="92*"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <Grid Grid.Row="0" Background="#33adff">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16*"/>
                <ColumnDefinition Width="44*"/>
                <ColumnDefinition Width="40*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="White"
/>
            <Image Grid.Column="0"   Source="/logo.png" Stretch="Fill" 
                   Visibility="Visible" Width="150" Height="60" VerticalAlignment="Center" Margin="20,0,0,0" HorizontalAlignment="Left" />

            <TextBlock Grid.Column="1" Text="NAPEANS ORDER MANAGEMENT" FontSize="25" 
                       HorizontalAlignment="Center" Margin="200 20 -200 0"
                       FontWeight="Bold" FontFamily="Bell MT"
                       Foreground="Black"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="2">
                <Button Tag="WindowMaximize" Click="MaximizeRestore_Click" Margin="4">
                    <materialDesign:PackIcon Kind="WindowMinimize" />
                </Button>
                <Button Tag="WindowClose" Click="Close_Click" Margin="0 0 5 0">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========== CONTENT ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16*"/>
                <ColumnDefinition Width="84*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== SIDE MENU ========== -->
            <Grid Grid.Column="0" Background="#33adff">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                 <Button Grid.Row="1" Content="Home" FontWeight="Bold" FontSize="16" Margin="-30,0,30,0" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="btnHome_click" Style="{StaticResource NavButtonStyle}" 
                        Foreground="Black">

                </Button>

                <TreeView Grid.Row="2" x:Name="treeViewMenu" Background="Transparent"
                          xmlns:wpfGif="http://wpfanimatedgif.codeplex.com">

                    <TreeViewItem Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                        <TreeViewItem.Header>
                            <TextBlock Text="Sales" FontWeight="Bold" Background="Transparent" Foreground="Black" FontSize="16" />
                        </TreeViewItem.Header>

                        <!-- Customers -->
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <Button Click="btnCustomer_click" Style="{StaticResource NavButtonStyle}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Black">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="imgCustomer"
                                               Width="24" Height="24" Margin="0,0,5,0"
                                               wpfGif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/user.gif"
                                               wpfGif:ImageBehavior.AutoStart="False" />
                                        <TextBlock Text="Customers" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <!-- Project Master -->
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <Button Click="btnproject_click" Style="{StaticResource NavButtonStyle}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Black">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="imgProject"
                                               Width="24" Height="24" Margin="0,0,5,0"
                                               wpfGif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/project.gif"
                                               wpfGif:ImageBehavior.AutoStart="False"/>
                                        <TextBlock Text="Project Master" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <Button Click="btnExpense_click" Style="{StaticResource NavButtonStyle}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Black">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="imgExpense"
                                                Width="24" Height="24" Margin="0,0,5,0"
                                                wpfGif:ImageBehavior.AnimatedSource="/Assets/expense.png"
                                                wpfGif:ImageBehavior.AutoStart="False"/>
                                        <TextBlock Text="Expense Manager" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <!-- Quotation -->
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <Button Click="btnQuotation_click" Style="{StaticResource NavButtonStyle}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Black">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="imgQuotation"
                                               Width="24" Height="24" Margin="0,0,5,0"
                                               wpfGif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/quote.gif"
                                               wpfGif:ImageBehavior.AutoStart="False"/>
                                        <TextBlock Text="Quotation" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <!-- Invoice -->
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <Button Click="btnInvoice_Click" Style="{StaticResource NavButtonStyle}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Black">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="imgInvoice"
                                               Width="24" Height="24" Margin="0,0,5,0"
                                               wpfGif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/invoice.gif"
                                               wpfGif:ImageBehavior.AutoStart="False"/>
                                        <TextBlock Text="Invoice" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <!-- Settings -->
                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <Button Click="btnSettings_click" Style="{StaticResource NavButtonStyle}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Black">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="imgSettings"
                                               Width="24" Height="24" Margin="0,0,5,0"
                                               wpfGif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/settings.gif"
                                               wpfGif:ImageBehavior.AutoStart="False"/>
                                        <TextBlock Text="Settings" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <TreeViewItem>
                            <TreeViewItem.Header>
                                <Button Click="btnDC_Click"  Style="{StaticResource NavButtonStyle}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="Black">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="imgDC"
                                                Width="24" Height="24" Margin="0,0,5,0"
                                                wpfGif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/quote.gif"
                                                wpfGif:ImageBehavior.AutoStart="False"/>
                                        <TextBlock Text="Delivery Challan" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>


            </Grid>

            <!-- ========== PAGE CONTENT ========== -->
            <Grid Grid.Column="1">
                <Frame x:Name="mainFrame" NavigationUIVisibility="Hidden"/>
            </Grid>

        </Grid>

    </Grid>
</Window>
