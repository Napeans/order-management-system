<Page x:Class="cuatomers.QuoteHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cuatomers"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="QuoteHistory">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="quoteDataGrid"
          AutoGenerateColumns="False"
          Margin="10"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          RowHeight="40"
          FontSize="13"
          GridLinesVisibility="All"
          AlternatingRowBackground="#F9F9F9"
          HeadersVisibility="Column"
          ColumnHeaderHeight="35"
          BorderThickness="1"
          BorderBrush="#DDD"
          HorizontalAlignment="Stretch">

            <DataGrid.Resources>
                <!-- Header Style -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#33adff"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="Padding" Value="5,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Quote ID" Binding="{Binding QuoteID}" Width="100" />
                <DataGridTextColumn Header="Quote Number" Binding="{Binding QuoteNumber}" Width="120"/>
                <DataGridTextColumn Header="Quote Date" Binding="{Binding QuoteDate, StringFormat=d}" Width="110"/>
            
                <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="150"/>
              
            
                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=N2}" Width="120"/>

                <!-- View Button -->


                <!-- View Button -->
                <DataGridTemplateColumn Width="70" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="View" Click="ViewButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon Kind="Eye" Width="20"  Height="20" Foreground="Black"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Edit Button -->
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Edit" Click="EditQuoteButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon Kind="Edit" Width="20" Height="20" Foreground="Black"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Delete Button -->
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Delete" Click="DeleteButton_Click" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="Black"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Download Button -->
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Download" Click="downloadbutton_click" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon Kind="Download" Width="20" Height="20" Foreground="Black"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Add PO Info Button -->
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Add Po Info " Click="AddPoInfo_Click" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon Kind="AddBox" Width="20" Height="20" Foreground="Black"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1"  Background="#F2F2F2"
                         Padding="10"
                         BorderBrush="#DDD"
                         BorderThickness="1"
                         Margin="10,0,10,10"
                         DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal"
         HorizontalAlignment="Center"
         VerticalAlignment="Center">

                <!-- View -->
                <StackPanel Orientation="Vertical" Margin="20,0" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="View" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Edit -->
                <StackPanel Orientation="Vertical" Margin="20,0" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Edit" Width="16" Height="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Edit" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

              

                <!-- Add PO Info -->
                <StackPanel Orientation="Vertical" Margin="20,0" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AddBox" Width="16" Height="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Add Po Info" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Download -->
                <StackPanel Orientation="Vertical" Margin="20,0" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Download" Width="16" Height="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Download" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Delete -->
                <StackPanel Orientation="Vertical" Margin="20,0" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Delete" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>


    </Grid>
</Page>
