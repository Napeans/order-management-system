<Page x:Class="cuatomers.Pages.ValidationTry"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cuatomers.Pages"
          xmlns:behaviors="clr-namespace:cuatomers.EventHandlers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ValidationTry">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Name:"/>
        <TextBox behaviors:ValidationBehavior.EnableValidation="Required"/>

        <TextBlock Text="Email:" Margin="10,10,0,0"/>
        <TextBox behaviors:ValidationBehavior.EnableValidation="Required,Email"/>

        <TextBlock Text="Mobile:" Margin="10,10,0,0"/>
        <TextBox behaviors:ValidationBehavior.EnableValidation="Required,Mobile"/>

        <Button Content="Submit" Margin="0,20,0,0" Width="100" HorizontalAlignment="Left" Click="Submit_Click"/>
    </StackPanel>
</Page>
