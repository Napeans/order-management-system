<Page x:Class="cuatomers.Pages.home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cuatomers.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="home">
    
        <Page.Resources>
            <!-- Dashboard Card Style -->
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="24,20"/>
                <Setter Property="Margin" Value="12"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Metric Card Style -->
            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20,16"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#E2E8F0" BlurRadius="6" ShadowDepth="1" Opacity="0.2"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quick Action Button Style -->
            <Style x:Key="QuickActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="Padding" Value="20,16"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#33adff"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Action Button Style -->
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#33adff"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A9FD6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section Header Style -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Margin" Value="12,20,12,8"/>
            </Style>
        </Page.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Welcome Header -->
                <Grid Grid.Row="0" Margin="12,0,12,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome back!" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="#1E293B"
                              Margin="0,0,0,4"/>
                        <TextBlock Text="Here's what's happening with your business today." 
                              FontSize="16" 
                              Foreground="#64748B"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CurrentDateText" 
                              Text="July 22, 2025" 
                              FontSize="14" 
                              Foreground="#64748B"
                              VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Key Metrics Row -->
                <TextBlock Grid.Row="1" Text="📊 Key Metrics" Style="{StaticResource SectionHeaderStyle}"/>

                <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,0,20">

                    <!-- Total Customers -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#EBF8FF" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                                    <TextBlock Text="👥" FontSize="20" Foreground="#33adff"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="248" 
                                          FontSize="24" 
                                          FontWeight="Bold" 
                                          Foreground="#1E293B"/>
                                    <TextBlock Text="Total Customers" 
                                          FontSize="12" 
                                          Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↗️" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="+12% from last month" 
                                      FontSize="11" 
                                      Foreground="#10B981"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Active Projects -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#FEF3C7" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                                    <TextBlock Text="📋" FontSize="20" Foreground="#F59E0B"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="42" 
                                          FontSize="24" 
                                          FontWeight="Bold" 
                                          Foreground="#1E293B"/>
                                    <TextBlock Text="Active Projects" 
                                          FontSize="12" 
                                          Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="8 completed this week" 
                                      FontSize="11" 
                                      Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Monthly Revenue -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#F0FDF4" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                                    <TextBlock Text="💰" FontSize="20" Foreground="#10B981"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="₹8.2L" 
                                          FontSize="24" 
                                          FontWeight="Bold" 
                                          Foreground="#1E293B"/>
                                    <TextBlock Text="Monthly Revenue" 
                                          FontSize="12" 
                                          Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↗️" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="+18% from last month" 
                                      FontSize="11" 
                                      Foreground="#10B981"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pending Invoices -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#FEF2F2" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                                    <TextBlock Text="🧾" FontSize="20" Foreground="#EF4444"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="15" 
                                          FontSize="24" 
                                          FontWeight="Bold" 
                                          Foreground="#1E293B"/>
                                    <TextBlock Text="Pending Invoices" 
                                          FontSize="12" 
                                          Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="₹2.4L pending amount" 
                                      FontSize="11" 
                                      Foreground="#EF4444"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Quick Actions Section -->
                <TextBlock Grid.Row="3" Text="⚡ Quick Actions" Style="{StaticResource SectionHeaderStyle}"/>

                <UniformGrid Grid.Row="4" Rows="2" Columns="3" Margin="0,0,0,20">

                    <Button Style="{StaticResource QuickActionButtonStyle}" 
                        >
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Add Customer" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock Text="Register new customer" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickActionButtonStyle}" 
                        >
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="New Project" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock Text="Create project master" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickActionButtonStyle}" 
                         >
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="New Quotation" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock Text="Generate quotation" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickActionButtonStyle}" 
                        >
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="New Invoice" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock Text="Create invoice" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickActionButtonStyle}" 
                        >
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="View Expenses" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock Text="Manage expenses" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickActionButtonStyle}" 
                         >
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock Text="System configuration" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Recent Activity & Alerts Section -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent Activity -->
                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="📋 Recent Activity" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#1E293B"
                                  Margin="0,0,0,16"/>

                            <StackPanel x:Name="ActivityList">
                                <!-- Activity Item 1 -->
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#EBF8FF" CornerRadius="20" 
                                           Width="32" Height="32" Margin="0,0,12,0">
                                            <TextBlock Text="👥" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="New customer 'ABC Industries' added" 
                                                  FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="Customer registration completed" 
                                                  FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="2h ago" 
                                              FontSize="11" Foreground="#64748B" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>

                                <!-- Activity Item 2 -->
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#FEF3C7" CornerRadius="20" 
                                           Width="32" Height="32" Margin="0,0,12,0">
                                            <TextBlock Text="📝" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Quotation Q-2025-001 generated" 
                                                  FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="Amount: ₹1,25,000" 
                                                  FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="4h ago" 
                                              FontSize="11" Foreground="#64748B" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>

                                <!-- Activity Item 3 -->
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="20" 
                                           Width="32" Height="32" Margin="0,0,12,0">
                                            <TextBlock Text="✅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Project 'Automation Suite v2' completed" 
                                                  FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                            <TextBlock Text="Final delivery confirmed" 
                                                  FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="1d ago" 
                                              FontSize="11" Foreground="#64748B" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Button Content="View All Activity" 
                               Style="{StaticResource PrimaryActionButtonStyle}"
                               HorizontalAlignment="Left"
                               Margin="0,12,0,0"
                               />
                        </StackPanel>
                    </Border>

                    <!-- Alerts & Notifications -->
                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="🔔 Alerts" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#1E293B"
                                  Margin="0,0,0,16"/>

                            <StackPanel x:Name="AlertsList">
                                <!-- Alert Item 1 -->
                                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" 
                                   CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Payment Overdue" 
                                                  FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                                        </StackPanel>
                                        <TextBlock Text="Invoice #INV-2025-045 is 15 days overdue" 
                                              FontSize="11" Foreground="#991B1B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Alert Item 2 -->
                                <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" 
                                   CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="📅" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Project Deadline" 
                                                  FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                                        </StackPanel>
                                        <TextBlock Text="Project 'Data Migration' due in 3 days" 
                                              FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Alert Item 3 -->
                                <Border Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1" 
                                   CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="System Update" 
                                                  FontSize="12" FontWeight="Bold" Foreground="#0369A1"/>
                                        </StackPanel>
                                        <TextBlock Text="New features available in v2.1" 
                                              FontSize="11" Foreground="#075985" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Button Content="View All Alerts" 
                               Style="{StaticResource PrimaryActionButtonStyle}"
                               HorizontalAlignment="Stretch"
                               Margin="0,12,0,0"
                                 />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Page>