<Window x:Class="cuatomers.Pages.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cuatomers.Pages"
        mc:Ignorable="d"
         Title="Prompt" Height="700" Width="700">
    <StackPanel Margin="20">
        <TextBlock Text="Select Date:" Margin="0,0,0,5"/>
        <DatePicker x:Name="DateInput"/>

        <TextBlock Text="Say Project Name:" Margin="10,10,0,5"/>
        <TextBox x:Name="ProjectNameInput" Height="25"/>

        <TextBlock Text="Say Expense Details:" Margin="10,10,0,5"/>
        <TextBox x:Name="ExpenseDetailsInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <Button Content="Submit" Margin="10" Click="Submit_Click"/>
    </StackPanel>
</Window>