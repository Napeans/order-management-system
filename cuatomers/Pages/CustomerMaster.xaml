<Page x:Class="cuatomers.Pages.CustomerMaster"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cuatomers.Pages"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:events="clr-namespace:cuatomers.EventHandlers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CustomerMaster"> 
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="New Customer" FontSize="24" FontWeight="Bold" Foreground="#333"/>
                <Rectangle Height="1" Fill="DarkGray" HorizontalAlignment="Stretch" Margin="10 10 0 -10"/>

            </StackPanel>

            <!-- Prefill Notice -->
            

            <!-- Main Form -->
            <ScrollViewer Grid.Row="2">
                <StackPanel>






                    <!-- Company Name -->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,30">
                        <TextBlock Text="Company Name" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="*" Foreground="Red"/>


                        <TextBox x:Name="customerCompanyname" Padding="5,5,5,5"
                                  events:PlaceholderService.Placeholder="Enter your Company name"
                                  Margin="65 -10 0 0" Height="30" Width="300" 
                                  HorizontalAlignment="Left" BorderThickness="1 1 1 1"/>

                    </StackPanel>
                    <!-- Primary Contact -->

                    <StackPanel Margin="0,0,-10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Primary Contact" FontWeight="SemiBold"/>

                            <TextBlock Text="*" Foreground="Red"/>

                            <Grid Margin="65 0 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <ComboBox x:Name="customersaulition" Grid.Column="0" Height="30" SelectedIndex="0" Margin="0,-10,10,10" BorderThickness="1">
                                    <ComboBoxItem Content="Salutation"/>
                                    <ComboBoxItem Content="Mr."/>
                                    <ComboBoxItem Content="Ms."/>
                                    <ComboBoxItem Content="Mrs."/>
                                    <ComboBoxItem Content="Dr."/>
                                </ComboBox>
                                <StackPanel Margin="50,-3,-300,3" Orientation="Vertical">
                                    <TextBox x:Name="customerfirstname" 
                                         AcceptsReturn="True"  
                                         Grid.Column="1"  Padding="5,5,5,5"
                                         Foreground="Gray"  
                                         TextChanged="NameFields_TextChanged"    
                                         Margin="10,0,0,0" Width="200" Height="30"
                                         BorderThickness="1"  
                                         FocusVisualStyle="{x:Null}"
                                        
                                         events:PlaceholderService.Placeholder="Enter your First name"/>
                                    <TextBlock x:Name="txtfirstNameError" Margin="100 0 -100 0" Foreground="Red" />


                                </StackPanel>
                                <StackPanel  Margin="350,-3,-450,3" Orientation="Vertical">

                                    <TextBox x:Name="customerlastname"  
                                         AcceptsReturn="True"  
                                         Width="200" Height="30" Grid.Column="3" 
                                         Foreground="Gray"  Padding="5,5,5,5" 
                                         BorderThickness="1" Margin="0 0 0 0"
                                         FocusVisualStyle="{x:Null}" 
                                         TextChanged="NameFields_TextChanged"
                                             events:PlaceholderService.Placeholder="Enter your Last name"/>
                                    
                                    <TextBlock x:Name="txtlastNameError" Foreground="Red" />

                                </StackPanel>

                            </Grid>
                        </StackPanel>

                    </StackPanel>

                    <!-- GST Number -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="GST Number" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="Red"/>

                            <StackPanel Orientation="Vertical" Margin="33 0 0 0">
                                <TextBox x:Name="txtGst"  
                                         AcceptsReturn="True"  
                                         Width="200" Height="30" Grid.Column="3" 
                                         Foreground="Gray" Padding="5,5,5,5"  
                                         BorderThickness="1" Margin="50 0 0 0"
                                         FocusVisualStyle="{x:Null}" 
                                         TextChanged="GstNumber_TextChanged"
                                             events:PlaceholderService.Placeholder="Enter your GST Number"/>
                            <TextBlock x:Name="txtGstNumberError" Margin="50 0 0 0 " Foreground="Red" />

                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

              

                
                    <!-- Email Address -->
                    <StackPanel Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Email Address" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="Red"/>

                            <Grid Width="300" HorizontalAlignment="Left">
                                <StackPanel Orientation="Vertical" Margin="4 0 0 0">
                                    <TextBox x:Name="CustomarEmail"
                                          BorderThickness="1"
                                          FocusVisualStyle="{x:Null}"
                                          TextChanged="txtEmail_TextChanged"
                                          events:PlaceholderService.Placeholder="Enter your Email Address"
                                          Height="30" Padding="5,5,5,5" Margin="72 -10 0 10"/>
                                <TextBlock x:Name="txtError" Foreground="Red" Margin="80,-10,0,10"/>
                                </StackPanel>

                            </Grid>
                           

   
                        </StackPanel>
                    </StackPanel>

                    <!-- Phone -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Phone" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="Red"/>


                                    <StackPanel Orientation="Vertical" Margin="5 0 0 0">
                                        <TextBox x:Name="CustomerContact" 
                                             Height="30" 
                                             Padding="5,5,5,5"  
                                             Width="210"
                                             Margin="112 0 0 0" 
                                             BorderThickness="1 1 1 1" 
                                             events:PlaceholderService.Placeholder="Enter your Contect Number"
                                             Foreground="Black"
                                             FocusVisualStyle="{x:Null}"
                                             TextChanged="txtMobile_TextChanged"/>
                                        <TextBlock x:Name="txtMobileError" Margin="130 0 -130 0" Foreground="Red" />
                                    </StackPanel>

                                

                            
                        </StackPanel>
                    </StackPanel>

                    <!-- Tab Menu -->

                    <TabControl Background="White"  BorderBrush="Blue" Margin="10">


                        <TabItem Header="Address" >
                            <Grid Margin="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Billing Address Section -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Billing Address" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                                    <!-- Attention -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Attention" VerticalAlignment="Center"/>
                                        <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtAttention" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                    </Grid>

                                    <!-- Country/Region -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Country/Region" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <ComboBox x:Name="comboCountry" Grid.Column="1" 
                                                  Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1">
                                            <ComboBoxItem Content="Select" IsSelected="True" Foreground="#999999"/>
                                            <ComboBoxItem Content="India"/>
                                            <ComboBoxItem Content="America"/>
                                            <ComboBoxItem Content="UK"/>
                                            <ComboBoxItem Content="South Africa"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Address -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"  Orientation="Horizontal">
                                            <TextBlock Text="Address" VerticalAlignment="Top" Margin="0,8,0,0"/> 
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBox x:Name="txtStreet1" Height="60" Padding="8"
                                                     BorderBrush="#CCCCCC" BorderThickness="1" 
                                                     TextWrapping="Wrap" AcceptsReturn="True" 
                                                     VerticalScrollBarVisibility="Auto"
                                                     events:PlaceholderService.Placeholder="Enter your Address 1"
                                                      Foreground="#999999" Margin="0,0,0,8"/>
                                            <TextBox x:Name="txtStreet2" Height="60" Padding="8" 
                                                     BorderBrush="#CCCCCC" BorderThickness="1" 
                                                     TextWrapping="Wrap" AcceptsReturn="True" 
                                                     VerticalScrollBarVisibility="Auto"
                                                     events:PlaceholderService.Placeholder="Enter your Address 2"
                                                     Foreground="#999999"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- City -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="City" VerticalAlignment="Center"/>
                                           <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                       </StackPanel>
                                <TextBox x:Name="txtCity" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                    </Grid>

                                    <!-- State -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="State" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <ComboBox x:Name="comboState" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1">
                                            <ComboBoxItem Content="Select or type to add" IsSelected="True" Foreground="#999999"/>
                                            <ComboBoxItem Content="Tamil Nadu"/>
                                            <ComboBoxItem Content="Kerala"/>
                                            <ComboBoxItem Content="Karnadaga"/>
                                            <ComboBoxItem Content="Thelungana"/>
                                            <ComboBoxItem Content="Andra"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Pin Code -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Pin Code" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtPin" Grid.Column="1" 
                                                 Height="35" Padding="8" 
                                                 BorderBrush="#CCCCCC" 
                                                 BorderThickness="1"
                                                 FocusVisualStyle="{x:Null}"
                                                 TextChanged="txtPin_TextChanged"/>
                                        <TextBlock x:Name="txtPinError" Margin="130 35 -100 -35"
                                                   Foreground="Red" />
                                    </Grid>

                                    <!-- Phone -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Phone" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10 25 0 -25 " Foreground="Red"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical" Margin="120 10 -350 0">
                                            <TextBox x:Name="txtphone" 
                                                 Grid.Column="1" Height="35" 
                                                 Padding="8" 
                                                 BorderBrush="#CCCCCC" 
                                                 BorderThickness="1"
                                                 FocusVisualStyle="{x:Null}"
                                                 TextChanged="txtMobile_TextChanged"/>
                                        <TextBlock x:Name="txtPhoneError" Margin="10 0 0 0"
                                                   Foreground="Red" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fax Number -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Fax Number" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtfax" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                                
                                

                                <!-- Shipping Address Section -->
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <TextBlock Text="Shipping Address" FontSize="16" FontWeight="Bold"/>

                                    </StackPanel>

                                    <!-- Attention -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Attention" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <TextBox x:Name="shipAttention" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                    </Grid>

                                    <!-- Country/Region -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Country/Region" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <ComboBox x:Name="shipcontry" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1">
                                            <ComboBoxItem Content="Select" IsSelected="True" Foreground="#999999"/>
                                            <ComboBoxItem Content="India"/>
                                            <ComboBoxItem Content="America"/>
                                            <ComboBoxItem Content="UK"/>
                                            <ComboBoxItem Content="South Africa"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Address -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Address" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBox x:Name="shipadd1" Height="60" Padding="8" 
                                                     BorderBrush="#CCCCCC" BorderThickness="1" 
                                                     TextWrapping="Wrap" AcceptsReturn="True" 
                                                     VerticalScrollBarVisibility="Auto"
                                                     events:PlaceholderService.Placeholder="Enter your Address 1"
                                                     Foreground="#999999" Margin="0,0,0,8"/>
                                            <TextBox x:Name="shipadd2" Height="60" Padding="8" 
                                                     BorderBrush="#CCCCCC" BorderThickness="1" 
                                                     TextWrapping="Wrap" AcceptsReturn="True" 
                                                     VerticalScrollBarVisibility="Auto"
                                                     events:PlaceholderService.Placeholder="Enter your Address 2"
                                                     Foreground="#999999"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- City -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="City" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <TextBox x:Name="shipcity" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                    </Grid>

                                    <!-- State -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="State" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <ComboBox x:Name="shisate" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1">
                                            <ComboBoxItem x:Name="shipstate" Content="Select or type to add" IsSelected="True" Foreground="#999999"/>
                                            <ComboBoxItem Content="Tamil Nadu"/>
                                            <ComboBoxItem Content="Kerala"/>
                                            <ComboBoxItem Content="Karnadaga"/>
                                            <ComboBoxItem Content="Thelungana"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Pin Code -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Pin Code" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <TextBox x:Name="shippin" Grid.Column="1"
                                                 Height="35" Padding="8" 
                                                 BorderBrush="#CCCCCC" 
                                                 BorderThickness="1"
                                                 FocusVisualStyle="{x:Null}"
                                                 TextChanged="txtPin_TextChanged"/>
                                        <TextBlock x:Name="txtShiPinError" Margin="130 35 -140  -35"
                                                   Foreground="Red" /> 
                                    </Grid>

                                    <!-- Phone -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Phone" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10 25 0 -25" Foreground="Red"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical" Margin="120 10 -350 0">
                                            <TextBox x:Name="shipphone" Grid.Column="1" 
                                                 Height="35" Padding="8" 
                                                 BorderBrush="#CCCCCC" 
                                                 BorderThickness="1"
                                                 FocusVisualStyle="{x:Null}"
                                                 TextChanged="txtMobile_TextChanged"/>
                                        <TextBlock x:Name="txtShiPhoneError" Margin="10 0 0 0" 
                                                   Foreground="Red" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fax Number -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Grid.Column="0" Text="Fax Number" VerticalAlignment="Center"/>
                                            <TextBlock Text="*" Margin="10" Foreground="Red"/>
                                        </StackPanel>
                                        <TextBox x:Name="shipfax" Grid.Column="1" Height="35" Padding="8" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                    </Grid>
                                    <CheckBox x:Name="SameAsBillingCheckBox"
                                              Content="Shipping address same as billing"
                                              Checked="SameAsBillingCheckBox_Checked"
                                              Unchecked="SameAsBillingCheckBox_Unchecked"
                                              Margin="0,10,0,10"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Other Details">
                            <Grid>
                                <StackPanel>
                                    <!-- PAN -->
                                    <StackPanel Margin="0,30,0,20" Orientation="Horizontal"  >
                                        <TextBlock Text="PAN" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                      
                                        <Grid Width="300" HorizontalAlignment="Left">
                                            <TextBox x:Name="pannumber" Height="30" Margin=" 120 -5 -120 5" BorderThickness="1 1 1 1"  Foreground="Gray"/>

                                        </Grid>
                                        
                                        
                                    </StackPanel>

                                    <!-- Payment Terms -->
                                    <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                        <TextBlock Text="Currency" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                     
                                        <ComboBox x:Name="selectCurrency" Height="30" Width="300" HorizontalAlignment="Left" SelectedIndex="0" 
                                                  Margin="95 -5 -95 5" BorderThickness="1 1 1 1">
                                            <ComboBoxItem Content="AED-UAE Dirham"/>
                                            <ComboBoxItem Content="INR - Indian Rupee"/>
                                            <ComboBoxItem Content="AUD-Australian Doller"/>
                                            <ComboBoxItem Content="BND-Brunei Doller"/>
                                            <ComboBoxItem Content="CAD-Canadian Doller"/>
                                            <ComboBoxItem Content="CNY-Yuan Renminbi"/>
                                            <ComboBoxItem Content="EUR-Euro"/>
                                            <ComboBoxItem Content="GBP-Pound Sterling"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <!-- Opnening Balance -->
                                    <StackPanel Margin="0,30,0,20" Orientation="Horizontal"  >
                                        <TextBlock Text="Opening Balance" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <Grid Width="300" HorizontalAlignment="Left">
                                            <TextBox x:Name="openonin" 
                                                     Height="30" Margin="50 -5 -50 5" 
                                                     BorderThickness="1 1 1 1" 
                                                     Foreground="Gray"
                                                     events:PlaceholderService.Placeholder="Enter Opening Balance"/>

                                        </Grid>
                                    </StackPanel>

                                    <!-- Payment Terms -->
                                    <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                        <TextBlock Text="Payment Terms" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="compament" Height="30" Width="300" HorizontalAlignment="Left" SelectedIndex="0" 
                                                  Margin="57 -5 -57 5" BorderThickness="1 1 1 1">
                                            <ComboBoxItem Content="Due on Receipt"/>
                                            <ComboBoxItem Content="Net 15"/>
                                            <ComboBoxItem Content="Net 30"/>
                                            <ComboBoxItem Content="Net 60"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Enable Portal -->
                                    <!--<StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Enable Portal?" FontWeight="SemiBold"/>
                                          
                                        </StackPanel>
                                        <CheckBox Content="Allow portal access for this customer" Margin="60,-5,-60,5"/>
                                    </StackPanel>-->

                                    <!-- Portal Language -->
                                    <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Portal Language" FontWeight="SemiBold"/>
                                   
                                        </StackPanel>
                                        <ComboBox x:Name="portallang" Height="30" Width="300" HorizontalAlignment="Left" 
                                                  SelectedIndex="0" BorderThickness="1" Margin="50 -5 -50 5">
                                            <ComboBoxItem Content="English"/>
                                            <ComboBoxItem Content="Hindi"/>
                                            <ComboBoxItem Content="Tamil"/>
                                            <ComboBoxItem Content="Telugu"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Documents -->
                                    <StackPanel Margin="140,0,-140,20">
                                        <TextBlock Text="Documents" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <Border BorderBrush="#DDD" BorderThickness="1" Width="300" Height="80" HorizontalAlignment="Left" Background="#FAFAFA">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                                                <Button Content="📁 Upload File" Click="UploadSignature_Click" Background="Transparent" BorderThickness="0" Padding="10,5" Foreground="Blue" FontWeight="SemiBold"/>
                                                <TextBlock Text="You can upload a maximum of 10 files, 10MB each" FontSize="11" Foreground="Gray" TextAlignment="Center" Margin="0,5,0,0"/>


                                            </StackPanel>
                                        </Border>
                                        
                                        
                                    </StackPanel>

                       
                                </StackPanel>

                            </Grid>
                        </TabItem>

                    </TabControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Save and Cancel Buttons -->
            <Grid Grid.Row="3">
                <StackPanel  Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Click="Save_Customer" Content="Save" Foreground="White" Margin="0,0,10,0" FontWeight="SemiBold" BorderThickness="0"  
                            >
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color=" #0055ff" Offset="0.1"/>
                                <GradientStop Color="#00091a" Offset="1.1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button Click="CancelButton_Click" Content="Cancel"  Foreground="White"  BorderBrush="#CCC" BorderThickness="1">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color=" #ff33cc" Offset="0.1"/>
                                <GradientStop Color="#1a0013" Offset="1.1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>


            </Grid>



