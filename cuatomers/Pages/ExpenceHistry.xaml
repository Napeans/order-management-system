<Page x:Class="cuatomers.Pages.ExpenceHistry"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cuatomers.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExpenceHistry">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Filter and Print Controls -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="50" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Home" Click="home_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color=" #00e6e6" Offset="0.1"/>
                            <GradientStop Color="#000000" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Label Content="From:" VerticalAlignment="Center"/>
                <DatePicker x:Name="StartDatePicker" Width="120"/>
                <Label Content="To:" VerticalAlignment="Center"/>
                <DatePicker x:Name="EndDatePicker" Width="120"/>
                <Button Margin="10" Content="Filter" Width="100" Click="Filter_Click" >
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color=" #ff6666" Offset="0.1"/>
                            <GradientStop Color="#1a0013" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>

            <Button Grid.Column="1" Content="Print" Click="PrintButton_Click" Width="100" Height="35" Margin="10,0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color=" #ffd480" Offset="0.1"/>
                        <GradientStop Color="#1a0013" Offset="1.1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1" x:Name="HistoryGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="10"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding ExpenseOn, StringFormat='dd/MM/yyyy'}"/>
                <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding ExpenseValue}"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding ModeOfPay}"/>
                <DataGridTextColumn Header="Spent By" Binding="{Binding SpentBy}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>