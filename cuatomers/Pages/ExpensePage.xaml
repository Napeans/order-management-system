<Page x:Class="cuatomers.Pages.ExpensePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cuatomers.Pages" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExpensePage" Background="White">

    <Page.Resources>
        <Style x:Key="RedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="85*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,0">
            <TextBlock Text="Expense Manager" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20 0 0 30"/>
            <Rectangle Height="1" Fill="DarkGray" HorizontalAlignment="Center" Margin="10 10 0 -10"/>

        </StackPanel>
        <Grid Grid.Row="1">
 
            <StackPanel  Margin="100 0 0 0">
            <!-- Project Selection -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Project:" Margin="0 5" FontWeight="SemiBold"/>
                    <TextBlock Text="*" Margin="0" Foreground="Red"/>

                    <StackPanel Orientation="Vertical">
                    <ComboBox x:Name="selectProject" Width="300" Height="30" BorderThickness="1" Margin="110 0 -110 0"
                          DisplayMemberPath="Project_Name" SelectedValuePath="Project_ID" SelectionChanged="selectProject_SelectionChanged" />

                    <StackPanel Margin="10 0 0 0" Orientation="Vertical">
                        <TextBlock x:Name="extext" Text="Mention Here Other Expense Details" 
                               Margin="105 20 0 0" Foreground="Red"/>
                        <TextBox x:Name="OtherProjectTextBox" 
                               Width="300" Height="30" BorderThickness="1"
                               Visibility="Collapsed" Margin="100 0 -100 0" />
                    </StackPanel> 
                </StackPanel>

            </StackPanel>

            <!-- Expense Descriptor -->
            <StackPanel Margin="0 30" Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="Expense Description" Margin="0 5"/>
                <TextBox x:Name="txtexdecriptor" BorderThickness="1" Height="30" Width="300" Margin="45 0 -45 0"/>
            </StackPanel>

            <!-- Expense Value -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Expense Value:" FontWeight="SemiBold" Margin="0 5"/>
                    <TextBlock Text="*" Margin="0" Foreground="Red"/>
                    <TextBox x:Name="txtexpensevalue"
                         BorderThickness="1" 
                         Width="300"  Height="30" Margin="70 0 -70 0"
                         FocusVisualStyle="{x:Null}"
                         TextChanged="txtValue_TextChanged"/>
                    <TextBlock x:Name="txtValueError" Margin="-230 30 230 -30"
                               Foreground="Red"/>
            </StackPanel>

            <!-- Mode of Pay -->
            <StackPanel Orientation="Horizontal" Margin="0 20">
                <TextBlock FontWeight="SemiBold" Text="Mode of Pay:" Margin="0 5"/>
                    <TextBlock Text="*" Margin="0" Foreground="Red"/>
                    <StackPanel x:Name="txtmodeofpay" Margin="70 0 -70 0" Orientation="Horizontal">
                    <RadioButton x:Name="radioCash" Content="Cash" GroupName="PayMode" Margin="5 0"/>
                    <RadioButton x:Name="radioUPI" Content="GPay/UPI" GroupName="PayMode" Margin="5 0"/>
                    <RadioButton x:Name="radioCard" Content="Card" GroupName="PayMode" Margin="5 0"/>
                </StackPanel>
            </StackPanel>

            <!-- Spent By -->
            <StackPanel Orientation="Horizontal" Margin="0 20">
                
                <TextBlock FontWeight="SemiBold" Text="Spent By:" Margin="0 5"/>
                    <TextBlock Text="*" Margin="0" Foreground="Red"/>
                    <TextBox x:Name="txtspentby" BorderThickness="1" Width="300" Height="30" Margin="100 0 -100 0"/>
            </StackPanel>

            <!-- Expense On -->
            <StackPanel Orientation="Horizontal" Margin="0 20">
                <TextBlock Text="Expense On:" Margin="0 5"/>
                    <TextBlock Text="*" Margin="0" Foreground="Red"/>
                    <DatePicker x:Name="txtdate" Width="170" Height="30" BorderThickness="1" Margin="90 0 -90 0"/>
            </StackPanel>

            <!-- Save/Cancel Buttons -->
            <StackPanel Orientation="Horizontal">
                <Button Content="SAVE" Click="save_Expense" Margin="0 50 30 0" HorizontalAlignment="Left"
                         FontWeight="Bold" Width="100">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color=" #0055ff" Offset="0.1"/>
                            <GradientStop Color="#00091a" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Click="Refresh_Click" Content="Cancel" Margin="0 50 30 0" HorizontalAlignment="Left"
                         FontWeight="Bold" Width="100">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color=" #ff33cc" Offset="0.1"/>
                            <GradientStop Color="#1a0013" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                    <Button Click="Viwe_Click"  Content="Viwe History" Margin="0 50 30 0" HorizontalAlignment="Left"
          FontWeight="Bold" Width="120">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color=" #ff33cc" Offset="0.1"/>
                            <GradientStop Color="#1a0013" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>





            </StackPanel>
        </StackPanel>
        </Grid>

    </Grid>
</Page>
