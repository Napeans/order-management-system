<Page x:Class="cuatomers.Pages.DeliveryChallan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:cuatomers.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DeliveryChallan">
    <Page.Resources>
        <Style x:Key="RedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F9F9F9"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless TextBox -->
        <Style x:Key="BorderlessTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="DropShadowEffect" Color="Black" Direction="270" ShadowDepth="4" BlurRadius="8" Opacity="0.3"/>
    </Page.Resources>
     
    <Grid>
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="#F8F9FA" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="New Delivery Challan" FontSize="24" FontWeight="Bold" 
                       Margin="20,15" VerticalAlignment="Center"/>
                <Button Content="View History" Grid.Column="3" Click="btnDCHistory_Click"
Width="140"
Height="40"
Background="#4A90E2"
Foreground="White"
FontWeight="Bold"
FontSize="14"
BorderThickness="0"
Margin="10"
Padding="5"
Cursor="Hand"
HorizontalAlignment="Left"
VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4A90E2" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="Transparent" />

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#357ABD" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <!-- Company and Delivery Info -->
                    <Grid Margin="0,0,0,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Project Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name" VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                            <ComboBox x:Name="cmbProject"
          DisplayMemberPath="Project_Name"
          SelectedValuePath="Project_ID"
          SelectionChanged="cmbProject_SelectionChanged"
          Width="300"/>



                        </Grid>

                        <!-- Customer -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer"    VerticalAlignment="Top" Margin="0,5,0,35"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                            <StackPanel Margin="0"> 
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Margin="0">
                                            <ComboBox x:Name="cmbSelectedCustomer"
                   DisplayMemberPath="Full_Name"
                   SelectedValuePath="Full_Name"
                                                      SelectionChanged="cmbSelectedCustomer_SelectionChanged"
                    Width="300"/>


                                            <StackPanel Orientation="Horizontal"  >
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock x:Name="txtblkBilling"  Text="Billing Address:" Margin="0,20,0,5" FontWeight="Bold" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="txtBillingAddress"
                  TextWrapping="Wrap"
                  FontWeight="SemiBold"
                  Height="130"
                  Padding="5"
                  Visibility="Collapsed" />
                                                </StackPanel>
                                                <StackPanel Margin="50 0 0 0" HorizontalAlignment="Right" Orientation="Vertical"  >
                                                    <TextBlock x:Name="txtShipping"  Text="Shipping Address:" Margin="0,20,0,5" FontWeight="Bold" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="txtShippingAddress"
                    TextWrapping="Wrap"
                    FontWeight="SemiBold"
                    Height="130"
                    Padding="5"
                    Visibility="Collapsed" />

                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Delivery Challan Number -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="DC Number"   VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,15">
                            <TextBox x:Name="txtDCNumber" Text="DC-"/>
                        </Grid>

                        <!-- DC Date -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="DC Date" VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <DatePicker x:Name="dpDCDate"
            Grid.Row="3"
            Grid.Column="1"
            
            Margin="0,0,0,15" />

                        <!-- Trial/Demo -->
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Phase of Demo" VerticalAlignment="Center" Margin="0,0,0,15"/>
                        <ComboBox x:Name="cmbPhaseDemo" Grid.Row="3" Grid.Column="4" Margin="0,0,80,15">
                            <ComboBoxItem Content="Trial Demo"/>
                            <ComboBoxItem Content="Final Demo"/>
                            <ComboBoxItem Content="Installation"/>
                            <ComboBoxItem Content="Maintenance"/>
                        </ComboBox>

                        
                    </Grid>

                    <!-- Purpose/Subject -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="Purpose" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox x:Name="txtPurpose" Grid.Column="1" Text="Material delivered for demonstration/trial" Height="30" TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Top" VerticalContentAlignment="Top" Foreground="#999999"/>
                    </Grid>

                    <!-- Item Table -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">

                            <!-- Item Table Section -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Section Header -->
                                    <Grid Background="#F8F9FA" Height="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Item Details" 
                               FontWeight="Bold" FontSize="16"
                               VerticalAlignment="Center" 
                               Margin="20,0"/>
                                    </Grid>

                                    <!-- Table Column Headers -->
                                    <Grid Background="#F8F9FA" Height="45">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <!-- S.No -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Item Details -->
                                            <ColumnDefinition Width="110"/>
                                            <!-- Quantity -->
                                            <ColumnDefinition Width="110"/>
                                            <!-- UOM -->
                                            <ColumnDefinition Width="60"/>
                                            <!-- (Optional Delete Column if needed) -->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
               Text="S.No."
               FontWeight="Bold"
               FontSize="12"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
               Text="ITEM DETAILS"
               FontWeight="Bold"
               FontSize="12"
               VerticalAlignment="Center"
               Margin="25,0"/>

                                        <TextBlock Grid.Column="2"
               Text="QUANTITY"
               FontWeight="Bold"
               FontSize="12"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>

                                        <!-- ✅ NEW UOM COLUMN HEADER -->
                                        <TextBlock Grid.Column="3"
               Text="UOM"
               FontWeight="Bold"
               FontSize="12"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
                                    </Grid>


                                    <!-- Item Rows Container -->
                                    <StackPanel x:Name="ItemPanel">
                                        <!-- Item Row Template -->
                                        <Grid Height="80" Background="White" Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <!-- S.No -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Item Details -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- Quantity -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- UOM -->
                                                <ColumnDefinition Width="60"/>
                                                <!-- Delete -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Serial Number -->
                                            <TextBlock Grid.Column="0"
                   Text="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontWeight="Medium"/>

                                            <!-- Item Description -->
                                            <TextBox Grid.Column="1" x:Name="txtStaticItemDescription"
                 Text="Enter Item Details"
                 Style="{StaticResource BorderlessTextBox}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Height="50"
                 VerticalContentAlignment="Center"
                 Margin="0"
                 Foreground="Black"/>

                                            <!-- Quantity -->
                                            <TextBox Grid.Column="2" x:Name="txtStaticItemQty"
                 Text="1"
                 Style="{StaticResource BorderlessTextBox}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Height="50"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Width="60"/>

                                            <!-- UOM -->
                                            <ComboBox Grid.Column="3" x:Name="cmbStaticUOM"
                  Width="100"
                  Height="50"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Style="{StaticResource MaterialDesignComboBox}">
                                                <ComboBoxItem Content="Nos"/>
                                                <ComboBoxItem Content="Kg"/>
                                                <ComboBoxItem Content="Litre"/>
                                                <ComboBoxItem Content="Box"/>
                                            </ComboBox>

                                            <!-- Delete Button -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Button Content="✕"
                    Style="{StaticResource SecondaryButton}"
                    Foreground="#FF5722"
                    FontSize="14"
                    Width="30"
                    Height="30"
                    Padding="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Add Row Button -->
                                    <StackPanel Orientation="Horizontal" 
                            Margin="25,20" 
                            Background="White">
                                        <Button x:Name="btnAddNewRow" 
                            Content="➕ Add New Row" 
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,15,0"
                            Click="btnAddNewRow_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Additional Information Section -->
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Delivery Instructions -->
                                <StackPanel Grid.Column="0" Margin="0,0,25,0">
                                    <TextBlock Text="Delivery Instructions" 
                           FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,15"/>
                                    <TextBox x:Name="txtDeliveryInstructions" 
                         Text="Handle with care. Returnable delivery challan." 
                         Height="110"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         VerticalContentAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#CCCCCC" 
                         BorderThickness="1"
                         Padding="10"/>
                                </StackPanel>

                                <!-- Terms & Conditions -->
                                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                                    <TextBlock Text="Terms And Conditions" 
                           FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,15"/>
                                    <TextBox x:Name="txtTermsAndConditions" 
                         Text="1. Material is delivered for demonstration purpose only.&#x0a;2. Items should be returned in good condition.&#x0a;3. Any damage will be charged to customer." 
                         Height="110"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         VerticalContentAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#CCCCCC" 
                         BorderThickness="1"
                         Padding="10"/>
                                </StackPanel>
                            </Grid>

                            <!-- Signature Section -->
                            <Grid Margin="0,40,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Prepared By -->
                                <StackPanel Grid.Column="0" Margin="0,0,25,0">
                                    <TextBlock Text="Prepared By" 
                           FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,50"/>
                                    <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" 
                        Height="1" Margin="0,0,0,15"/>
                                    <TextBlock Text="Signature &amp; Date" 
                           FontSize="12" Foreground="#666666" 
                           HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Delivered By -->
                                <StackPanel Grid.Column="1" Margin="12.5,0">
                                    <TextBlock Text="Delivered By" 
                           FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,50"/>
                                    <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" 
                        Height="1" Margin="0,0,0,15"/>
                                    <TextBlock Text="Signature &amp; Date" 
                           FontSize="12" Foreground="#666666" 
                           HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Received By -->
                                <StackPanel Grid.Column="2" Margin="25,0,0,0">
                                    <TextBlock Text="Received By" 
                           FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,50"/>
                                    <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" 
                        Height="1" Margin="0,0,0,15"/>
                                    <TextBlock Text="Signature &amp; Date" 
                           FontSize="12" Foreground="#666666" 
                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Background="#F8F9FA" Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Button x:Name="btnSaveAndSend" Content="Save and Send"   Margin="0,0,10,0" Click="btnSaveAndSend_Click"  >
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0055ff" Offset="0.1"/>
                                <GradientStop Color="#00091a" Offset="1.1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button   Content="Cancel" Foreground="White" >
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#ff33cc" Offset="0.1"/>
                                <GradientStop Color="#1a0013" Offset="1.1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Page>
