<Page x:Class="cuatomers.Pages.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cuatomers.Pages"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800"
        Title="InvoiceSettings"  >
    <Page.Resources>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="TextElement.Foreground" Value="#99d6ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnderlinedTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>
                            <Border Padding="{TemplateBinding Padding}" Background="Transparent" Grid.Row="0">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <Border x:Name="UnderlineBorder" Grid.Row="1" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="TextElement.Foreground" Value="#33adff"/>
                                <Setter TargetName="UnderlineBorder" Property="Background" Value="#33adff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#67E3A5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5AD394"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4DC484"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*" />
            <RowDefinition Height="70*" />
            <RowDefinition Height="15*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,0">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20 0 0 30"/>
            <Rectangle Height="1" Fill="DarkGray" HorizontalAlignment="Center" Margin="10 10 0 -10"/>

        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
            <Grid Margin="30,20,30,0"  >
                <Grid.RowDefinitions>
                    <!-- Add more as needed -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Upload Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Upload Signature -->
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <!-- Left Column Items -->
                <!-- Company Name -->
                <Label Grid.Row="0" Grid.Column="0" Content="Company Name" Margin="0,0,15,15" />
                <TextBox x:Name="txtCompanyName" Grid.Row="0" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Company Address -->
                <Label Grid.Row="1" Grid.Column="0" Content="Address" Margin="0,0,15,15"/>
                <TextBox x:Name="txtCompanyAddress" Grid.Row="1" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- GST Number -->
                <Label Grid.Row="2" Grid.Column="0" Content="GST NO" Margin="0,0,15,15"/>
                <TextBox x:Name="txtGST" Grid.Row="2" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Company Email -->
                <Label Grid.Row="3" Grid.Column="0" Content="Email" Margin="0,0,15,15"/>
                <TextBox x:Name="txtEmail" Grid.Row="3" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Company Phone -->
                <Label Grid.Row="4" Grid.Column="0" Content="Phone" Margin="0,0,15,15"/>
                <TextBox x:Name="txtPhone" Grid.Row="4" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Payments Due -->
                <Label Grid.Row="5" Grid.Column="0" Content="Payments Due" Margin="0,0,15,15"/>
                <ComboBox x:Name="cmbPaymentsDue" Grid.Row="5" Grid.Column="1" Width="400" SelectedIndex="1" Margin="0,0,0,15">
                    <ComboBoxItem Content="7 days"/>
                    <ComboBoxItem Content="14 days"/>
                    <ComboBoxItem Content="30 days"/>
                    <ComboBoxItem Content="45 days"/>
                    <ComboBoxItem Content="60 days"/>
                </ComboBox>

                <!-- Sales Person -->
                <Label Grid.Row="6" Grid.Column="0" Content="Sales Person" Margin="0,0,15,15"/>
                <TextBox x:Name="txtSalesPerson" Grid.Row="6" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Bank Details Header -->
                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
       Text="Bank Details"
       FontSize="16"
       FontWeight="Bold"
       Foreground="Purple"
       Margin="0,20,0,10" />

                <!-- Bank Name -->
                <Label Grid.Row="8" Grid.Column="0" Content="Bank Name" Margin="0,0,15,15"/>
                <TextBox x:Name="txtBankName" Grid.Row="8" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Account Number -->
                <Label Grid.Row="9" Grid.Column="0" Content="Account Number" Margin="0,0,15,15"/>
                <TextBox x:Name="txtAccountNumber" Grid.Row="9" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- IFSC Code -->
                <Label Grid.Row="10" Grid.Column="0" Content="IFSC Code" Margin="0,0,15,15"/>
                <TextBox x:Name="txtIFSC" Grid.Row="10" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Branch Address -->
                <Label Grid.Row="11" Grid.Column="0" Content="Branch Address" Margin="0,0,15,15"/>
                <TextBox x:Name="txtBranchAddress" Grid.Row="11" Grid.Column="1" Width="400" Margin="0,0,0,15"/>

                <!-- Upload Logo -->
                <Label Grid.Row="0" Grid.Column="2" Content="Upload Logo" Margin="0,0,15,0" HorizontalAlignment="Right" />
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,15" >
                    <Button Content="Choose Logo" Width="120" Margin="0,0,10,0" Click="UploadLogo_Click"/>
                    <Image x:Name="LogoPreview" Width="100" Height="50" Stretch="Uniform"/>
                </StackPanel>

                <!-- Upload Signature -->
                <Label Grid.Row="1" Grid.Column="2" Content="Upload Signature" Margin="0,0,15,0" HorizontalAlignment="Right"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="Choose Sign" Width="120" Margin="0,0,10,0" Click="UploadSignature_Click"/>
                    <Image x:Name="SignaturePreview" Width="100" Height="50" Stretch="Uniform"/>
                </StackPanel>


            </Grid>
        </ScrollViewer>

        <!-- Save / Cancel Buttons -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,50,0">
                <Button  Click="SaveSettingsFromUI" Content="Save" Foreground="White" Margin="0,0,10,0" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0055ff" Offset="0.1"/>
                            <GradientStop Color="#00091a" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Button   Content="Cancel" Foreground="White" BorderBrush="#CCC" BorderThickness="1">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#ff33cc" Offset="0.1"/>
                            <GradientStop Color="#1a0013" Offset="1.1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

