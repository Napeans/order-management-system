<Window x:Class="cuatomers.Pages.AddPoInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cuatomers.Pages"
        mc:Ignorable="d"
        Title="AddPoInfo" Height="450" Width="800">
    <Grid Margin="0 50 0 -50">
        <StackPanel VerticalAlignment="Top" Width="300">
            <TextBlock Text="PO Number" Margin="0,10,0,2"/>
            <TextBox x:Name="PoNumberBox"/>

            <TextBlock Text="PO Date" Margin="0,10,0,2"/>
            <DatePicker x:Name="PoDatePicker"/>

            <TextBlock Text="Remarks" Margin="0,10,0,2"/>
            <TextBox x:Name="RemarksBox" Height="60" AcceptsReturn="True"/>

            <Button Content="Browse PO File" Click="BrowseFile_Click" Margin="0,10"/>
            <TextBlock x:Name="SelectedFileText" Text="No file selected" FontStyle="Italic"/>

            <Button Content="Save" Click="SavePO_Click" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
